# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#   cp .env.example .env
#
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Which Groq model the AI planner + self-critique use.
# Options include: llama-3.3-70b-versatile, llama-3.1-8b-instant,
# meta-llama/llama-4-maverick-17b-128e-instruct
GROQ_MODEL=llama-3.3-70b-versatile
